# --- שרת (Render / Railway / VPS) — לא רץ ב-Vercel ---
JWT_SECRET=שנה-אותי-למחרוזת-אקראית-ארוכה
NODE_ENV=production

# פרונט ב-Vercel + API בכתובת אחרת — חובה לעוגיות התחברות:
# CROSS_SITE_COOKIES=1

# מסד חינמי בענן (Supabase / Neon): הדבק את Connection String (URI). אם מוגדר — לא נדרש דיסק ב-Render.
# משתמשי Supabase: אם החיבור ל-host db.xxx.supabase.co נכשל מ-Render (IPv4), השתמש ב-URI של Session Pooler מהדשבורד.
# אם בסיסמת ה-DB יש תווים מיוחדים (@ # וכו') — חובה להקיד אותם ב-URI או החלפת סיסמה.
# DATABASE_URL=postgresql://...
# אם יש בעיית SSL מקומית בלבד: DATABASE_SSL=0

# SQLite מקומי רק כשאין DATABASE_PATH:
# DATABASE_PATH=

# --- מקור נתוני מניות ישראליות ---
# Cache בזיכרון לתשובות /api/israeli-stock/:id (במילי-שניות).
# 0 משבית כליל. ברירת־מחדל 45 שניות. הגדל אם אתה רואה הרבה quote_ok=tase_html_scrape בלוג ורוצה פחות עומס.
# ISRAELI_STOCK_CACHE_TTL_MS=45000

# סדר מאגרים לפי שם מופרד בפסיקים. ברירת־מחדל: tase → tase_scrape
#   tase         = JSON של דף הבורסה (majordata) — מהיר (~500ms)
#   tase_scrape  = משיכת HTML מרונדר עם puppeteer — איטי (~4-5s) אבל "אמיתי",
#                  ותומך גם בחיפוש לפי שם דרך מילון השמות (TASE_NAME_ALIASES)
# דוגמאות:
# ISRAELI_QUOTE_PIPELINE=tase,tase_scrape
# ISRAELI_QUOTE_PIPELINE=tase_scrape,tase
#
# בסיס והקשר טעינת API של הבורסה (יכול להידרש אם מתקבל 403 מתוך שרת Cloud):
# TASE_API_BASE_URL=https://api.tase.co.il/api
# TASE_LANG=he
# ברירת־מחדל compId=0 מספיקה למספר נייר; אם צריך אפשר לציין מזהה חברה:
# TASE_COMPANY_ID=0
# TASE_HTTP_ORIGIN=https://market.tase.co.il
# TASE_HTTP_REFERER=https://market.tase.co.il/
# TASE_HTTP_USER_AGENT=
#
# --- TASE HTML web-scraper (puppeteer) ---
# הסקרייפר מפעיל דפדפן headless ומושך שער אחרון + שינוי מהדף
# https://market.tase.co.il/he/market_data/security/<id>/major_data
# Cache TTL בשרת (ברירת מחדל 60 שניות):
# TASE_SCRAPE_CACHE_TTL_MS=60000
# Timeout לטעינת הדף וטעינת ה-XHR של המחירים (במילי-שניות):
# TASE_SCRAPE_NAV_TIMEOUT_MS=30000
# TASE_SCRAPE_RENDER_TIMEOUT_MS=25000
# מילון שמות חופשיים ל-secId (חיפוש לפי שם — TASE חוסמים חיפוש מבחוץ,
# לכן יש מילון מובנה שניתן להרחיב כאן). דוגמה:
# TASE_NAME_ALIASES={"רמי לוי":"1104248","מליסרון":"323014"}

# --- בניית React ב-Vercel (Settings → Environment Variables → Production) ---
# כתובת השרת בלי סלאש בסוף, לדוגמה https://xxx.onrender.com
# REACT_APP_API_URL=
